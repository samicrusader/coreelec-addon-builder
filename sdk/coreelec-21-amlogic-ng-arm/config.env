# SDK definition: one directory under sdk/ per CoreELEC release + device.
# Sourced by scripts/prepare-sdk.sh and scripts/build-addon.sh, and read by the
# GitHub workflows to name the image tag. Plain KEY="value" lines only.

# CoreELEC 21 (Kodi 21.2 Omega) - pinned so every SDK image is reproducible.
COREELEC_REPOSITORY="https://github.com/CoreELEC/CoreELEC.git"
COREELEC_REF="15970b8e469b8e299a8947b1751593bdaf53ed82"

# Amlogic-ng with 32-bit userspace (S905X2/X3, S922X, A311D, ...).
PROJECT="Amlogic-ce"
DEVICE="Amlogic-ng"
ARCH="arm"

# Packages built into the image. Anything an addon needs beyond these is built
# on demand when the addon is built (slower, but it still works).
SDK_PACKAGES="toolchain kodi-platform curl pugixml rapidjson tinyxml2"

# ftp.gnu.org is unreliable from GitHub runners; GNU URLs are rewritten to this.
GNU_MIRROR="https://mirrors.kernel.org/gnu"

# Fallback for any source tarball whose upstream host won't serve GitHub's
# runners (zlib.net hands them an HTML page). Blank disables the fallback.
GENTOO_DISTFILES="https://distfiles.gentoo.org/distfiles"

# Image tag suffix: ghcr.io/<owner>/coreelec-addon-builder:<SDK_TAG>
SDK_TAG="21-amlogic-ng-arm"
